# Production Environment Configuration
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

NEXT_PUBLIC_APP_NAME=Cruizr
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_API_URL=https://api.cruizr.app
NEXT_TELEMETRY_DISABLED=1

# Mapbox (production token)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_production_mapbox_token

# Google Genkit AI (production key)
GOOGLE_GENKIT_API_KEY=your_production_google_ai_key

# Firebase Production Project
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cruizr-prod
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cruizr-prod.firebaseapp.com

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DEBUG=false
NEXT_PUBLIC_ENABLE_REALM_SELECTION=true
NEXT_PUBLIC_ENABLE_VEILMODE=true
NEXT_PUBLIC_ENABLE_SAFETY_PROTOCOLS=true

# Production Settings
LOG_LEVEL=warn
ENABLE_REQUEST_LOGGING=false
ALLOWED_ORIGINS=https://cruizr.app,https://www.cruizr.app

# Security
SESSION_SECRET=generate_secure_secret_here
SESSION_MAX_AGE=86400

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
