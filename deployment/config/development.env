# Development Environment Configuration
NODE_ENV=development
PORT=9002
HOSTNAME=0.0.0.0

NEXT_PUBLIC_APP_NAME=Cruizr Dev
NEXT_PUBLIC_APP_VERSION=1.0.0-dev
NEXT_PUBLIC_API_URL=http://localhost:9002/api
NEXT_TELEMETRY_DISABLED=1

# Mapbox (use your actual token)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Google Genkit AI (use your actual key)
GOOGLE_GENKIT_API_KEY=your_google_ai_key_here

# Firebase Dev Project
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cruizr-dev

# Feature Flags (all enabled for development)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=true
NEXT_PUBLIC_ENABLE_REALM_SELECTION=true
NEXT_PUBLIC_ENABLE_VEILMODE=true
NEXT_PUBLIC_ENABLE_SAFETY_PROTOCOLS=true

# Development Settings
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true
DEV_MODE=true
MOCK_GPS_LOCATION=true
