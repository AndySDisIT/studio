# Staging Environment Configuration
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

NEXT_PUBLIC_APP_NAME=Cruizr Staging
NEXT_PUBLIC_APP_VERSION=1.0.0-staging
NEXT_PUBLIC_API_URL=https://staging.cruizr.app/api
NEXT_TELEMETRY_DISABLED=1

# Mapbox (staging token)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_staging_mapbox_token

# Google Genkit AI (staging key)
GOOGLE_GENKIT_API_KEY=your_staging_google_ai_key

# Firebase Staging Project
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cruizr-staging
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cruizr-staging.firebaseapp.com

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DEBUG=true
NEXT_PUBLIC_ENABLE_REALM_SELECTION=true
NEXT_PUBLIC_ENABLE_VEILMODE=true
NEXT_PUBLIC_ENABLE_SAFETY_PROTOCOLS=true

# Staging Settings
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
